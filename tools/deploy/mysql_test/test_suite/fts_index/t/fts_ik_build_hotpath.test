# owner: fts
# tags: fts
# description: IK character reuse and first/subsequent index builds. Frozen
# TOKENIZE answers use column input to avoid the constant-result cache. Compare
# complete hit sets and scores across DDL and DML, then rebuild after updates.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS ik_hot_bulk, ik_hot_dml, ik_hot_tokens, ik_hot_latin;
--enable_warnings

CREATE TABLE ik_hot_bulk
  (id INT PRIMARY KEY, title VARCHAR(128), body TEXT)
  DEFAULT CHARSET=utf8mb4;
INSERT INTO ik_hot_bulk VALUES
(1,'quasar','2026 11 01 1234567890 3.14159'),
(2,'nebula','full-text well-known state-of-the-art peer-to-peer'),
(3,'quasar','一二三四五'),
(4,'quasar','3.14159 full-text 一二三四五'),
(5,'nebula','asteroid comet'),
(6,'',''),(7,NULL,NULL),
(8,'quasar',REPEAT('3.14159 full-text 一二三四五 ',1600));

# The first build must still initialize the real runtime IK dictionary even
# when the obsolete SQL dictionary-load task state is skipped.
ALTER TABLE ik_hot_bulk ADD FULLTEXT INDEX ft_all(title,body) WITH PARSER ik;
ALTER TABLE ik_hot_bulk ADD FULLTEXT INDEX ft_body(body) WITH PARSER ik;
CREATE TABLE ik_hot_dml
  (id INT PRIMARY KEY, title VARCHAR(128), body TEXT)
  DEFAULT CHARSET=utf8mb4;
ALTER TABLE ik_hot_dml ADD FULLTEXT INDEX ft_all(title,body) WITH PARSER ik;
ALTER TABLE ik_hot_dml ADD FULLTEXT INDEX ft_body(body) WITH PARSER ik;
INSERT INTO ik_hot_dml SELECT * FROM ik_hot_bulk;

--echo ik_decimal_ids
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_bulk
WHERE MATCH(body) AGAINST('3.14159');
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_dml
WHERE MATCH(body) AGAINST('3.14159');
--echo ik_connector_ids
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_bulk
WHERE MATCH(body) AGAINST('full-text');
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_dml
WHERE MATCH(body) AGAINST('full-text');
--echo ik_chinese_number_ids
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_bulk
WHERE MATCH(body) AGAINST('一二三四五');
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_dml
WHERE MATCH(body) AGAINST('一二三四五');
--echo ik_multicol_scores
SELECT COUNT(*) AS hits, MAX(ABS(a.score-b.score)) < 0.000000000001 AS same_scores
FROM (SELECT id, MATCH(title,body) AGAINST('quasar') AS score
      FROM ik_hot_bulk WHERE MATCH(title,body) AGAINST('quasar')) a
JOIN (SELECT id, MATCH(title,body) AGAINST('quasar') AS score
      FROM ik_hot_dml WHERE MATCH(title,body) AGAINST('quasar')) b ON a.id=b.id;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_bulk
WHERE MATCH(title,body) AGAINST('quasar');
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_dml
WHERE MATCH(title,body) AGAINST('quasar');

UPDATE ik_hot_bulk SET body='full-text full-text' WHERE id=1;
UPDATE ik_hot_dml SET body='full-text full-text' WHERE id=1;
DELETE FROM ik_hot_bulk WHERE id=4;
DELETE FROM ik_hot_dml WHERE id=4;
ALTER TABLE ik_hot_bulk DROP INDEX ft_body;
ALTER TABLE ik_hot_bulk ADD FULLTEXT INDEX ft_body(body) WITH PARSER ik;
--echo ik_rebuilt_connector_ids
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_bulk
WHERE MATCH(body) AGAINST('full-text');
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM ik_hot_dml
WHERE MATCH(body) AGAINST('full-text');
SELECT COUNT(*) AS hits, MAX(ABS(a.score-b.score)) < 0.000000000001 AS same_scores
FROM (SELECT id, MATCH(body) AGAINST('full-text') AS score
      FROM ik_hot_bulk WHERE MATCH(body) AGAINST('full-text')) a
JOIN (SELECT id, MATCH(body) AGAINST('full-text') AS score
      FROM ik_hot_dml WHERE MATCH(body) AGAINST('full-text')) b ON a.id=b.id;

CREATE TABLE ik_hot_tokens
  (id INT PRIMARY KEY, body TEXT, expected TEXT) DEFAULT CHARSET=utf8mb4;
# First three oracles are frozen in fts_tokenize_hotpath_regression.result.
INSERT INTO ik_hot_tokens VALUES
(1,'full-text well-known state-of-the-art peer-to-peer',
 '["peer-to-peer", "full-text", "state-of-the-art", "well-known"]'),
(2,'2026 11 01 1234567890 3.14159',
 '["01", "3.14159", "1234567890", "11", "2026"]'),
(3,'一二三四五','["一二三四五"]'),
(4,'3.14159','["3.14159"]'),
(5,'full-text','["full-text"]'),
(6,'一二三四五 一二三四五','["一二三四五"]'),
(7,'','[]'),(8,'   ','[]');
--echo ik_column_token_bytes
SELECT id, HEX(CAST(TOKENIZE(body,'ik') AS CHAR)) = HEX(expected) AS same_tokens
FROM ik_hot_tokens ORDER BY id;
# Change inputs so reused contexts cannot pass by retaining the previous word.
UPDATE ik_hot_tokens SET body='一二三四五', expected='["一二三四五"]' WHERE id=1;
UPDATE ik_hot_tokens SET body='full-text', expected='["full-text"]' WHERE id=3;
SELECT id, HEX(CAST(TOKENIZE(body,'ik') AS CHAR)) = HEX(expected) AS same_tokens
FROM ik_hot_tokens WHERE id IN (1,3) ORDER BY id;

# Skipping a load state must not bypass the existing charset validation.
CREATE TABLE ik_hot_latin (id INT PRIMARY KEY, body TEXT) DEFAULT CHARSET=latin1;
INSERT INTO ik_hot_latin VALUES (1,'full-text');
--disable_result_log
--error ER_NOT_SUPPORTED_YET
ALTER TABLE ik_hot_latin ADD FULLTEXT INDEX ft(body) WITH PARSER ik;
--enable_result_log

DROP TABLE ik_hot_bulk, ik_hot_dml, ik_hot_tokens, ik_hot_latin;
--enable_query_log
