# owner: fts
# tags: fts
# description: Only a direct scalar COUNT(*) may ignore implicit relevance
# order in a plain MATCH/LIMIT child. Nullable counts, parent filters, visible
# IDs and scores must retain the original choice of rows.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS fts_count_limit;
--enable_warnings
CREATE TABLE fts_count_limit (
  id INT PRIMARY KEY, marker INT, content TEXT
) ORGANIZATION INDEX;
# Equal document lengths and increasing term frequency give a strict relevance
# order 5,4,3,2,1, deliberately different from primary-key order.
INSERT INTO fts_count_limit VALUES
(1,1,'quasar filler filler filler filler filler'),
(2,1,'quasar quasar filler filler filler filler'),
(3,1,'quasar quasar quasar filler filler filler'),
(4,1,'quasar quasar quasar quasar filler filler'),
(5,NULL,'quasar quasar quasar quasar quasar filler'),
(6,1,'nebula filler filler filler filler filler');
ALTER TABLE fts_count_limit ADD FULLTEXT INDEX ft(content) WITH PARSER beng;

--echo count_below_equal_above_and_zero_limit
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 20) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 5) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 0) t;
--echo count_offsets_and_empty_matches
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 3 OFFSET 3) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 3 OFFSET 5) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 3 OFFSET 20) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('nonexistentword') LIMIT 2) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('') LIMIT 2) t;
--echo overlapping_terms_and_multiple_plain_columns
SELECT COUNT(*) AS hits FROM
  (SELECT id,marker FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar filler') LIMIT 20) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar nebula') LIMIT 4) t;

--echo ordinary_limit_still_returns_relevance_order
SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 3;
SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2 OFFSET 2;
--echo outer_nullable_count_still_observes_selected_rows
SELECT COUNT(marker) AS nonnull_hits FROM
  (SELECT marker FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t;
--echo outer_filter_still_observes_selected_rows
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t WHERE id<=2;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t WHERE id>=4;
--echo outer_sum_and_group_concat_still_observe_selected_rows
SELECT SUM(id) AS id_sum FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t;
--echo projected_scores_remain_available
SELECT id, score>0 AS positive_score FROM
  (SELECT id,MATCH(content) AGAINST('quasar') AS score FROM fts_count_limit
   WHERE MATCH(content) AGAINST('quasar') LIMIT 2) t ORDER BY id;
--echo explicit_order_is_preserved
SELECT COUNT(marker) AS nonnull_hits FROM
  (SELECT marker FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') ORDER BY id LIMIT 2) t;
SELECT COUNT(*) AS hits FROM
  (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar') ORDER BY id LIMIT 2) t;
SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST('quasar')
  ORDER BY MATCH(content) AGAINST('quasar') DESC LIMIT 2;
--echo prepared_search_limit_offset_reuse
PREPARE fts_count_limit_stmt FROM
'SELECT COUNT(*) AS hits FROM (SELECT id FROM fts_count_limit WHERE MATCH(content) AGAINST(?) LIMIT ? OFFSET ?) t';
SET @fts_query='quasar', @fts_limit=2, @fts_offset=0;
EXECUTE fts_count_limit_stmt USING @fts_query,@fts_limit,@fts_offset;
SET @fts_limit=20, @fts_offset=3;
EXECUTE fts_count_limit_stmt USING @fts_query,@fts_limit,@fts_offset;
SET @fts_query='nebula', @fts_offset=0;
EXECUTE fts_count_limit_stmt USING @fts_query,@fts_limit,@fts_offset;
SET @fts_query='nonexistentword';
EXECUTE fts_count_limit_stmt USING @fts_query,@fts_limit,@fts_offset;
SET @fts_query='quasar', @fts_limit=5;
EXECUTE fts_count_limit_stmt USING @fts_query,@fts_limit,@fts_offset;
DEALLOCATE PREPARE fts_count_limit_stmt;
DROP TABLE fts_count_limit;
--enable_query_log
